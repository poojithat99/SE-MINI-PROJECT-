# Copy to .env for local development. Never commit .env.
# Generate a strong value with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Comma-separated public frontend origins (optional for localhost dev).
# Example: https://your-frontend.onrender.com
AI_CMS_CORS_ORIGINS=

# Optional admin user seeded during app startup. Set real values only locally.
AI_CMS_ADMIN_USERNAME=admin
AI_CMS_ADMIN_EMAIL=admin@example.com
AI_CMS_ADMIN_PASSWORD=replace_with_a_strong_password
